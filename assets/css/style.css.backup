:root {
  /* Typographie */
  --font-family-heading: 'Poppins', sans-serif;
  --font-family-body: 'Roboto', sans-serif;

  /* Palette de couleurs modernisée - Optimisée pour l'accessibilité */
  --color-dark: #0f172a;       /* Bleu nuit très sombre (plus élégant que le noir pur) */
  --color-text: #334155;       /* Gris ardoise pour le texte (moins fatiguant) */
  --color-text-light: #475569; /* Pour les sous-titres - Amélioré pour AAA */

  /* Couleur Accent : Optimisée pour un meilleur contraste */
  --color-accent: #1d4ed8;     /* Bleu plus foncé pour meilleur contraste sur blanc */
  --color-accent-hover: #1e40af;

  --color-background: #f8fafc; /* Fond très légèrement bleuté/gris */
  --color-surface: #ffffff;
  --color-white: #ffffff;

  /* Espacements fluides */
  --spacing-xs: 0.5rem;
  --spacing-sm: 1rem;
  --spacing-md: 2rem;
  --spacing-lg: 4rem;
  --spacing-xl: 6rem;

  /* Ombres modernes (douces et diffusées) */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);

  --border-radius: 16px;
  --container-width: 1100px;
}

/* Reset & Base */
*, *::before, *::after { box-sizing: border-box; }

body {
  font-family: var(--font-family-body);
  margin: 0;
  background-color: var(--color-background);
  /* Suppression du motif SVG daté pour un look plus clean */
  color: var(--color-text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* Typographie fluide */
h1, h2, h3, .logo-main {
  font-family: var(--font-family-heading);
  color: var(--color-dark);
  line-height: 1.2;
  text-wrap: balance;
}

.hero-text h1 {
  font-family: 'Inter', sans-serif; /* New font */
  font-weight: 700;
  font-size: clamp(2.5rem, 6vw, 3.5rem);
  line-height: 1.1;
  margin-bottom: var(--spacing-sm);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3); /* Subtle shadow */

  /* Effet dégradé sur le texte */
  background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;

  /* Fallback pour vieux navigateurs */
  color: var(--color-dark);
}

.hero {
  position: relative;
  /* Ajoute une forme douce en arrière-plan */
  background: radial-gradient(circle at top right, #e0e7ff 0%, transparent 40%);
  padding: 2rem 0;
  border-radius: var(--border-radius);
}

h2 {
  font-size: clamp(1.75rem, 4vw, 2.25rem);
  margin-bottom: 2rem;
  position: relative;
  display: inline-block;
}

/* Petit soulignement stylé pour les H2 */
section h2::after {
  content: '';
  display: block;
  width: 60px;
  height: 4px;
  background: var(--color-accent);
  margin: 0.5rem auto 0;
  border-radius: 2px;
}

h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
}

p { margin-bottom: 1.5rem; }

a {
  color: var(--color-accent);
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s, outline 0.2s;
}

a:hover { color: var(--color-accent-hover); }

/* États de focus pour l'accessibilité clavier */
a:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
  border-radius: 2px;
}

.container {
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 1.5rem; /* Marges latérales de sécurité */
}

/* --- HEADER (Correction Accessibilité) --- */
.site-header {
  background: var(--color-dark);
  color: var(--color-white);
  padding: 1rem 0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.logo a {
  display: flex;
  flex-direction: column;
  color: var(--color-white);
}

.logo-main { font-size: 1.25rem; color: var(--color-white); }
.logo-sub { font-size: 0.85rem; opacity: 0.8; font-weight: 400; }

.main-nav {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.main-nav a {
  color: var(--color-white); /* Blanc pur pour un meilleur contraste */
  font-size: 0.95rem;
  padding: 0.5rem 0;
  position: relative;
  opacity: 0.95;
}

.main-nav a:hover {
  color: var(--color-white);
  text-decoration: none;
}

.main-nav a:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
  border-radius: 2px;
}

/* Effet de soulignement animé au survol */
.main-nav a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--color-accent);
  transition: width 0.3s;
}
.main-nav a:hover::after { width: 100%; }

/* --- HERO SECTION --- */
.site-main { padding-top: 3rem; }

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.hero-subtitle {
  font-size: 1.15rem;
  color: var(--color-text-light);
  margin-bottom: 2rem;
}

.hero-image img {
  width: 100%;
  height: auto;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-lg);
  transform: rotate(1deg); /* Petit effet dynamique */
  transition: transform 0.3s;
}

.hero-image img:hover { transform: rotate(0); }

/* --- SERVICES (Cartes Modernes) --- */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin: 3rem 0;
}

.service-card {
  background: var(--color-surface);
  border-radius: var(--border-radius);
  padding: 0; /* On laisse l'image toucher les bords */
  box-shadow: var(--shadow-md);
  transition: transform 0.3s, box-shadow 0.3s;
  overflow: hidden; /* For images to respect rounded borders */
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(0,0,0,0.03); /* Ultra subtle border */
}

/* The image zooms slightly on card hover */
.service-card:hover img {
  transform: scale(1.05);
  transition: transform 0.4s ease;
}

/* The card lifts slightly */
.service-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  border-color: var(--color-accent); /* Small touch of color on the border */
}

/* Smooth transition for the image */
.service-card img {
  transition: transform 0.4s ease;
}

.service-card figure { margin: 0; }

.service-card img {
  max-width: 240px; /* Fixed max-width to control size */
  width: 100%;     /* Responsive on smaller cards */
  height: auto;
  display: block;
  margin: 1.5rem auto 1rem; /* Center and add vertical spacing */
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
}

.service-card-text {
  padding: 1.5rem;
  flex-grow: 1;
}

.service-card h3 {
  margin-top: 0;
  color: var(--color-accent);
}

/* --- BOUTONS (CTA) --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.8rem 1.5rem;
  border-radius: 50px; /* Pill buttons more modern */
  font-weight: 600;
  text-align: center;
  transition: all 0.2s;
  border: none;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
}

.btn-primary {
  background-color: var(--color-accent);
  color: white;
}

.btn-primary:hover {
  background-color: var(--color-accent-hover);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  text-decoration: none;
  color: white;
}

.btn-primary:focus-visible {
  outline: 2px solid var(--color-dark);
  outline-offset: 2px;
}

.btn-whatsapp {
  background-color: #25D366;
  color: #fff; /* White text on green */
  font-weight: 700;
}

.btn-whatsapp:hover {
  background-color: #1ebc57;
  color: #fff;
  text-decoration: none;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
}

/* --- SECTIONS & LISTES --- */
.list-icon {
  color: var(--color-accent);
  font-weight: bold;
  margin-right: 0.5rem;
}
.list-icon::before { content: "✓"; }

/* Original ul/li styles */
ul { padding-left: 1rem; }
li { margin-bottom: 0.5rem; list-style: none; }

/* --- AVIS CLIENTS --- */
.avis-card {
  background: white;
  border: 1px solid #f1f5f9;
  border-radius: var(--border-radius);
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: var(--shadow-sm);
}

.avis-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.avis-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
}

.avis-stars { color: #d97706; } /* Jaune plus foncé pour meilleur contraste */

/* --- INFOGRAPHIE --- */
.infographie-container {
  display: flex;
  justify-content: center;
  margin: 3rem 0;
  padding: 1.5rem;
  background-color: white; /* Fond blanc pour détacher l'image du fond gris */
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(0,0,0,0.05);
}

.infographie-container figure {
  margin: 0;
  width: 100%;
  display: flex;
  justify-content: center;
}

.infographie-container img {
  width: 100%;
  height: auto;
  /* C'est ici qu'on règle le problème : */
  max-width: 500px; /* On limite la largeur maximale (ajuste ce chiffre si besoin) */
  max-height: 80vh; /* On s'assure qu'elle ne dépasse pas 80% de la hauteur de l'écran */
  object-fit: contain;
  border-radius: 8px;
}

/* --- FOOTER --- */
.site-footer {
  background: var(--color-dark);
  color: #94a3b8;
  padding: 3rem 0;
  margin-top: 4rem;
  text-align: center;
}

.site-footer a { color: var(--color-white); }

/* --- RESPONSIVE --- */
@media (max-width: 768px) {
  .hero-inner {
    grid-template-columns: 1fr; /* Empilement sur mobile */
    text-align: center;
  }

  .hero-text { order: 2; }
  .hero-image { order: 1; margin-bottom: 1rem; }

  .header-inner {
    flex-direction: column;
    gap: 1rem;
  }

  .main-nav {
    justify-content: center;
    gap: 1rem;
  }

  h1 { font-size: 2.2rem; }

  .btn { width: 100%; } /* Boutons pleine largeur sur mobile */
}

/* --- UTILITAIRES --- */
.fade-in-section {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}
.fade-in-section.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.back-to-top-btn {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: var(--color-dark);
  color: white;
  width: 45px;
  height: 45px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 99;
  box-shadow: var(--shadow-lg);
}
.back-to-top-btn.show { opacity: 1; }

/* --- PAGE PROFIL --- */
.profil-header {
  align-items: center; /* Centre verticalement le texte par rapport à l'image */
}

.profil-image,
.service-image {
  flex: 1 1 300px; /* Base size for image container */
  display: flex;
  justify-content: center;
  align-items: center;
}

.service-image {
  flex-grow: 0; /* Prevent the service image container from growing */
}

.profil-image img,
.service-image img {
  width: 100%;
  max-width: 380px; /* Max width for the image itself */
  height: auto;
  border-radius: var(--border-radius);
  display: block;
  box-shadow: var(--shadow-lg);
}

/* Sur mobile, on s'assure que l'image n'est pas trop envahissante */
 @media (max-width: 768px) {
  .profil-image img {
    max-width: 280px;
  }
}

/* Sur grand écran uniquement, on inverse un bloc sur deux */
 @media (min-width: 768px) {
  .service-block:nth-child(even) {
    flex-direction: row-reverse;
  }

  /* On ajoute un peu d'espace entre le texte et l'image */
  .service-block {
    align-items: center; /* Centre verticalement */
    gap: 4rem; /* Plus d'espace */
  }
}

/* Cible les listes dans les sections de contenu, mais pas dans le menu */
.site-main ul {
  list-style: none; /* Enlève les puces par défaut */
  padding-left: 0;
}

.site-main ul li {
  position: relative;
  padding-left: 2rem; /* Espace pour l'icône */
  margin-bottom: 0.8rem;
}

/* Création de la puce personnalisée */
.site-main ul li::before {
  content: '✓'; /* Caractère check */
  position: absolute;
  left: 0;
  top: 0;
  color: var(--color-accent); /* Bleu */
  font-weight: 900;
  font-size: 1.1rem;
  background-color: #eff6ff; /* Fond bleu très clair */
  width: 24px;
  height: 24px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
}
/* Styles pour le formulaire de devis Fabrice Auto */

.devis-section {
  padding: 4rem 0;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.devis-section .section-title {
  text-align: center;
  margin-bottom: 1rem;
  color: #2c3e50;
  font-size: 2.5rem;
}

.devis-section .section-subtitle {
  text-align: center;
  color: #6c757d;
  margin-bottom: 3rem;
  font-size: 1.1rem;
}

/* Formulaire multi-étapes */
.devis-form {
  max-width: 900px;
  margin: 0 auto;
  background: white;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  padding: 2.5rem;
  position: relative;
  overflow: hidden;
}

.form-step {
  display: none;
  animation: fadeIn 0.5s ease;
}

.form-step.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Grille de formulaire */
.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 600;
  color: #495057;
  font-size: 0.95rem;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 2px solid #e9ecef;
  border-radius: 8px;
  font-size: 1rem;
  transition: all 0.3s ease;
  background: #f8f9fa;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: #3498db;
  background: white;
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.form-group input[required] + label::after,
.form-group select[required] + label::after {
  content: " *";
  color: #e74c3c;
}

/* Checkboxes personnalisées */
.services-checklist {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.checkbox-label {
  display: flex;
  align-items: center;
  cursor: pointer;
  padding: 0.75rem;
  border-radius: 8px;
  transition: all 0.2s ease;
  border: 2px solid #e9ecef;
}

.checkbox-label:hover {
  border-color: #3498db;
  background: #f8fafc;
}

.checkbox-label input[type="checkbox"] {
  display: none;
}

.checkmark {
  width: 20px;
  height: 20px;
  border: 2px solid #adb5bd;
  border-radius: 4px;
  margin-right: 12px;
  position: relative;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.checkbox-label input[type="checkbox"]:checked + .checkmark {
  background: #3498db;
  border-color: #3498db;
}

.checkbox-label input[type="checkbox"]:checked + .checkmark::after {
  content: "✓";
  position: absolute;
  color: white;
  font-size: 14px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* Boutons */
.form-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e9ecef;
}

.btn {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-primary {
  background: #3498db;
  color: white;
}

.btn-primary:hover {
  background: #2980b9;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
}

.btn-secondary {
  background: #6c757d;
  color: white;
}

.btn-secondary:hover {
  background: #5a6268;
}

.btn-success {
  background: #27ae60;
  color: white;
}

.btn-success:hover {
  background: #219653;
}

/* Récapitulatif */
.recap-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-bottom: 2rem;
}

.recap-section {
  background: #f8f9fa;
  padding: 1.5rem;
  border-radius: 8px;
  border-left: 4px solid #3498db;
}

.recap-section h4 {
  margin-top: 0;
  margin-bottom: 1rem;
  color: #2c3e50;
  font-size: 1.1rem;
}

.recap-section p {
  margin: 0.5rem 0;
  color: #495057;
}

.price-section {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-left-color: #27ae60;
}

.price-breakdown {
  margin-top: 1rem;
}

.price-line {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px dashed #dee2e6;
}

.price-line.total {
  border-top: 2px solid #27ae60;
  border-bottom: none;
  padding-top: 1rem;
  margin-top: 0.5rem;
  font-size: 1.2rem;
  color: #2c3e50;
}

.price-note {
  font-size: 0.85rem;
  color: #6c757d;
  margin-top: 1rem;
  font-style: italic;
}

/* Message de confirmation */
.confirmation-message {
  text-align: center;
  padding: 3rem 2rem;
}

.confirmation-icon {
  font-size: 4rem;
  color: #27ae60;
  margin-bottom: 1.5rem;
  animation: bounce 1s ease;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
  40% {transform: translateY(-20px);}
  60% {transform: translateY(-10px);}
}

.confirmation-message h3 {
  color: #2c3e50;
  margin-bottom: 1rem;
}

.confirmation-message p {
  color: #495057;
  margin-bottom: 0.75rem;
  line-height: 1.6;
}

/* Indicateur de progression (optionnel) */
.progress-indicator {
  display: flex;
  justify-content: space-between;
  margin-bottom: 3rem;
  position: relative;
}

.progress-indicator::before {
  content: '';
  position: absolute;
  top: 15px;
  left: 0;
  right: 0;
  height: 2px;
  background: #e9ecef;
  z-index: 1;
}

.progress-step {
  position: relative;
  z-index: 2;
  text-align: center;
  flex: 1;
}

.step-circle {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #e9ecef;
  color: #6c757d;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 0.5rem;
  font-weight: bold;
  transition: all 0.3s ease;
}

.progress-step.active .step-circle {
  background: #3498db;
  color: white;
  transform: scale(1.1);
}

.progress-step.completed .step-circle {
  background: #27ae60;
  color: white;
}

.step-label {
  font-size: 0.85rem;
  color: #6c757d;
  font-weight: 500;
}

/* Responsive */
@media (max-width: 768px) {
  .devis-form {
    padding: 1.5rem;
    margin: 0 1rem;
  }

  .devis-section .section-title {
    font-size: 2rem;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .recap-container {
    grid-template-columns: 1fr;
  }

  .form-buttons {
    flex-direction: column;
    gap: 1rem;
  }

  .btn {
    width: 100%;
  }
}

/* États de validation */
.form-group.error input,
.form-group.error select,
.form-group.error textarea {
  border-color: #e74c3c;
  background: #fff5f5;
}

.error-message {
  color: #e74c3c;
  font-size: 0.85rem;
  margin-top: 0.25rem;
  display: none;
}

.form-group.error .error-message {
  display: block;
}

/* Spinner de chargement */
.loading-spinner {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Consentement */
.consent {
  margin-top: 2rem;
  padding: 1rem;
  background: #f8fafc;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.consent .checkbox-label {
  border: none;
  padding: 0;
}

.consent .checkbox-label:hover {
  background: transparent;
}

/* --- GALERIE AVANT/APRÈS --- */
.before-after-gallery {
  margin: 4rem 0;
  padding: 2rem;
  background: var(--color-surface);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-md);
}

.gallery-header {
  text-align: center;
  margin-bottom: 3rem;
}

.gallery-header h3 {
  font-size: 1.75rem;
  color: var(--color-dark);
  margin-bottom: 0.5rem;
}

.gallery-header p {
  color: var(--color-text-light);
  max-width: 600px;
  margin: 0 auto;
}

.gallery-items {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 3rem;
}

.gallery-item {
  background: white;
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s, box-shadow 0.3s;
}

.gallery-item:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
}

.image-comparison {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  padding: 1rem;
  background: #f8fafc;
}

.before-image,
.after-image {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
}

.before-image img,
.after-image img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  transition: transform 0.3s;
}

.before-image:hover img,
.after-image:hover img {
  transform: scale(1.05);
}

.image-label {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
}

.before-image .image-label {
  background: #ef4444; /* Rouge pour "Avant" */
}

.after-image .image-label {
  background: #10b981; /* Vert pour "Après" */
}

.gallery-caption {
  padding: 1.5rem;
}

.gallery-caption h4 {
  color: var(--color-dark);
  margin-top: 0;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.gallery-caption p {
  color: var(--color-text);
  font-size: 0.95rem;
  margin-bottom: 0;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .gallery-items {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .image-comparison {
    grid-template-columns: 1fr;
  }
  
  .before-image img,
  .after-image img {
    height: 180px;
  }
}
