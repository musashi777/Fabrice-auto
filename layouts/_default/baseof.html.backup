<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>{{ block "title" . }}{{ .Title }} – {{ .Site.Title }}{{ end }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{ if .IsHome }}
    <meta name="description" content="{{ .Site.Params.description }}" />
  {{ else if .Params.description }}
    <meta name="description" content="{{ .Params.description }}" />
  {{ end }}
  <meta property="og:title" content="{{ .Title }} – {{ .Site.Title }}" />
  <meta property="og:description" content="{{ with .Params.description }}{{ . }}{{ else }}{{ .Site.Params.description }}{{ end }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ .Permalink }}" />

  <!-- Préchargement des polices critiques -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Poppins:wght@700&family=Roboto:wght@400;700&display=swap">

  <!-- Préchargement de l'image hero (LCP) -->
  {{ if .IsHome }}
    <link rel="preload" as="image" href="{{ "images/optimized/hero-accueil.webp" | relURL }}" fetchpriority="high">
  {{ end }}

  <!-- Feuilles de style optimisées -->
  {{ $style := resources.Get "css/style.css" | postCSS | minify | fingerprint }}
  <link rel="stylesheet" href="{{ $style.RelPermalink }}" integrity="{{ $style.Data.Integrity }}">

  <!-- Script de chargement asynchrone des polices -->
  {{ $loadFontsJS := resources.Get "js/load-fonts.js" | minify | fingerprint }}
  <script defer src="{{ $loadFontsJS.RelPermalink }}" integrity="{{ $loadFontsJS.Data.Integrity }}"></script>

  <!-- Structured Data pour le SEO -->
  {{ partial "schema.html" . }}

  {{ hugo.Generator }}
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <div class="logo">
        <a href="{{ "/" | relURL }}">
          <span class="logo-main">Fabrice Auto</span>
          <span class="logo-sub">Nettoyage & rénovation</span>
        </a>
      </div>
      <nav class="main-nav">
        <a href="{{ "/" | relURL }}">Accueil</a>
        <a href="{{ "/services/" | relURL }}">Services</a>
        <a href="{{ "/profil/" | relURL }}">Profil</a>
        <a href="{{ "/contact/" | relURL }}">Contact</a>
        <!-- J'ai retiré "Articles" s'il n'y en a pas encore, sinon remets-le -->
      </nav>
    </div>
  </header>

  <main class="site-main">
    <!-- Le container est géré par le CSS global -->
    <div class="container">
      {{ block "main" . }}{{ end }}
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p>&copy; {{ now.Year }} Fabrice Auto – Marseille</p>
      <p>
        <a href="tel:+33614031995">06 14 03 19 95</a> •
        <a href="mailto:fabjouit@gmail.com">fabjouit@gmail.com</a>
      </p>
    </div>
  </footer>

  <!-- Import du bouton WhatsApp -->
  {{ partial "whatsapp-btn.html" . }}

  <a href="#" class="back-to-top-btn">↑</a>

  <script>
    const backToTopBtn = document.querySelector(".back-to-top-btn");

    window.addEventListener("scroll", () => {
      if (window.scrollY > 200) { // Show button after scrolling 200px
        backToTopBtn.classList.add("show");
      } else {
        backToTopBtn.classList.remove("show");
      }
    });

    backToTopBtn.addEventListener("click", (e) => {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    });

    // Fade-in sections on scroll
    const fadeInSections = document.querySelectorAll(".fade-in-section");

    const observerOptions = {
      root: null, // viewport
      rootMargin: "0px",
      threshold: 0.1 // 10% of element visible
    };

    const sectionObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target); // Stop observing once visible
        }
      });
    }, observerOptions);

    fadeInSections.forEach(section => {
      sectionObserver.observe(section);
    });

    // Enregistrement du Service Worker
    const registerSW = '{{ (resources.Get "js/register-sw.js" | minify | fingerprint).RelPermalink }}';
    const script = document.createElement('script');
    script.defer = true;
    script.src = registerSW;
    document.body.appendChild(script);
  </script>

  {{ $scrollAnimationsJS := resources.Get "js/scroll-animations.js" | minify | fingerprint }}
  <script defer src="{{ $scrollAnimationsJS.RelPermalink }}" integrity="{{ $scrollAnimationsJS.Data.Integrity }}"></script>

</body>
</html>
